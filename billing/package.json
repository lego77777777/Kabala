{
    "name": "kabala-billing",
    "version": "0.1.0",
    "private": true,
    "description": "Kabala subscriptions and payments (PayPal): pricing, plans, webhooks, licenses, invoices.",
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "start": "tsx src/server.ts",
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "tsx src/db/migrate.ts",
        "sync-pricing": "tsx src/scripts/sync-pricing.ts",
        "reconcile": "tsx src/scripts/reconcile.ts",
        "setup": "tsx src/scripts/setup.ts",
        "keys:generate": "tsx src/scripts/generate-license-keys.ts",
        "test:sandbox": "vitest run --config vitest.sandbox.config.ts",
        "pricing:check": "tsx src/scripts/sync-pricing.ts --check",
        "preview": "tsx test/preview.ts",
        "preview:receipt": "tsx test/preview-receipt.tsx",
        "email:dev": "email dev --dir src/email/templates --port 3001",
        "demo:receipt": "tsx src/scripts/demo-receipt.ts",
        "gmail:authorize": "tsx src/scripts/gmail-authorize.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1155.0",
        "@aws-sdk/s3-request-presigner": "^3.1155.0",
        "@electric-sql/pglite": "^0.5.10",
        "@fastify/helmet": "^13.2.0",
        "@fastify/rate-limit": "^11.2.1",
        "@fastify/static": "^10.1.6",
        "@paypal/paypal-js": "^11.3.0",
        "@paypal/paypal-server-sdk": "^2.5.0",
        "@react-email/components": "^1.0.12",
        "@react-email/render": "^2.1.1",
        "@react-pdf/renderer": "^4.9.0",
        "dotenv": "^18.0.8",
        "drizzle-orm": "^0.45.4",
        "fastify": "^5.12.7",
        "jose": "^6.2.13",
        "nodemailer": "^10.2.0",
        "pg-boss": "^12.38.0",
        "postgres": "^3.4.9",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@types/nodemailer": "^8.0.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "drizzle-kit": "^0.31.11",
        "react-email": "^6.11.3",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5"
    }
}
