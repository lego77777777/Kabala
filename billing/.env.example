# Copy to .env and fill in. NEVER commit .env. Sandbox and Live are fully separate.

NODE_ENV=development
PORT=8080
# public https URL of this server (checkout/account pages, links opened from the app)
PUBLIC_URL=http://localhost:8080
# production: postgres://user:pass@host:5432/kabala   ·   local: pglite:./.data/pglite
DATABASE_URL=pglite:./.data/pglite

# sandbox | live — selects which set below is used
PAYPAL_MODE=sandbox

# https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
# Webhook ID shown after registering https://<PUBLIC_URL>/api/webhooks/paypal in the sandbox app
PAYPAL_SANDBOX_WEBHOOK_ID=

# https://developer.paypal.com/dashboard/applications/live
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_LIVE_WEBHOOK_ID=

# npm run keys:generate
LICENSE_PRIVATE_KEY=
LICENSE_PUBLIC_KEY=
LICENSE_TTL_DAYS=7

# the desktop app's Google OAuth client id (from kabala-py/google_client.json)
GOOGLE_CLIENT_ID=
# admin panel (server/ /admin): its Ed25519 public key, from `python -m kabala_server.admin_billing keygen`
ADMIN_PANEL_PUBLIC_KEY=
APP_DEEP_LINK=kabala://payment-success

# ---- receipts --------------------------------------------------------------------------
# exempt = עוסק פטור (קבלה, no VAT) | licensed = עוסק מורשה / חברה (חשבונית מס/קבלה, VAT included in prices)
BUSINESS_TYPE=exempt
VAT_RATE_PERCENT=18
SELLER_NAME=Kabala
# ע.מ. / ח.פ. — required in production
SELLER_TAX_ID=
SELLER_ADDRESS=
SELLER_EMAIL=
# optional PNG/JPG for the receipt header
SELLER_LOGO=

# internal = our own PDF (dev, tests, customers abroad) | morning = Green Invoice / Morning (certified Israeli documents)
RECEIPT_PROVIDER=internal
# Morning → Settings → Developer tools → API keys. The sandbox is a separate Morning account with its own keys.
MORNING_API_KEY_ID=
MORNING_API_SECRET=
# sandbox: https://sandbox.d.greeninvoice.co.il/api/v1   production: https://api.greeninvoice.co.il/api/v1
MORNING_API_URL=https://sandbox.d.greeninvoice.co.il/api/v1

# where PDFs are kept: local | s3 (Amazon S3, Cloudflare R2, MinIO — use a PRIVATE bucket)
STORAGE=local
STORAGE_DIR=./.data/files
S3_BUCKET=
# R2: S3_REGION=auto and S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# encryption at rest: AES256 (default on AWS) or none (default with S3_ENDPOINT; R2 always encrypts)
S3_SSE=
# HMAC key for expiring PDF links (32+ random chars). Empty = derived from LICENSE_PRIVATE_KEY.
RECEIPT_LINK_SECRET=
# first retry delay for receipt jobs in seconds; doubles each time, 5 attempts in total
RECEIPT_RETRY_DELAY_SECONDS=30

# ---- email -------------------------------------------------------------------------------
# Pick ONE. Neither = emails are only logged (development).
#   local testing with Mailpit:  SMTP_URL=smtp://127.0.0.1:1025   (inbox at http://localhost:8025)
#   Gmail (no own domain yet):    SMTP_URL=smtps://you@gmail.com:<app-password>@smtp.gmail.com:465
#   Amazon SES / Postmark / any:  SMTP_URL=smtps://<user>:<password>@<host>:465
SMTP_URL=
RESEND_API_KEY=
# must be an address on a domain you verified (SPF + DKIM + DMARC), see README
MAIL_FROM=Kabala <billing@your-domain>
MAIL_REPLY_TO=
# gets an alert when a receipt fails after all retries
ADMIN_EMAIL=
# gets a hidden copy (Bcc) of every receipt sent to customers (your own records)
RECEIPT_COPY_TO=
